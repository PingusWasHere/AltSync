<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AltSync.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <AssemblyName>AltSync</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);.tools/**;tests/**;dist/**;artifacts/**;DiscordBot/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="Web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Discord\altsync.png" Link="Discord\altsync.png" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\AltSync.ico" />
    <EmbeddedResource Include="Branding\discord.json" LogicalName="AltSync.Branding.Discord.json" />
    <EmbeddedResource Include="Updater\install.ps1" LogicalName="AltSync.Updater.Install.ps1" />
  </ItemGroup>
</Project>
